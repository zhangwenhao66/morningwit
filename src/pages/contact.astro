---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL } from '../consts';
---
<Layout title="Contact" description="How to reach Morningwit." noindex>
	<div class="wrap-narrow prose">
		<h1>Contact</h1>
		<p>Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
		<p>We read bug reports, a board or hint that looks wrong, and suggestions for puzzles. Please include the page address and what you saw.</p>
	</div>
</Layout>
