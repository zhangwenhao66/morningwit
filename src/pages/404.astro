---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="That page is not on the table." noindex>
	<div class="wrap-narrow prose">
		<h1>That tile isn't on the table.</h1>
		<p>The page you wanted does not exist, or it moved. Head back and pick a puzzle.</p>
		<p><a class="btn primary" href="/">Back to today</a> <a class="btn" href="/play/">All games</a></p>
	</div>
</Layout>
