---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import Organization from '../../vendor/site-toolkit/packages/schema/src/Organization.astro';
import WebSite from '../../vendor/site-toolkit/packages/schema/src/WebSite.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_ORIGIN, CONTACT_EMAIL, INDEXABLE, ADS_ENABLED } from '../consts';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, ogImage = '/og.png', noindex = false } = Astro.props;
const pageTitle = title === SITE_TITLE ? `${SITE_TITLE}: small logic puzzles, gentle hints` : `${title} | ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, SITE_ORIGIN).href;
const ogImageURL = new URL(ogImage, SITE_ORIGIN).href;
const blocked = noindex || !INDEXABLE;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fffbf5" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/logo-512.png" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} updates`} href="/rss.xml" />
		<meta name="msvalidate.01" content="7C70BE631F366666FA497E858FB854AD" />
		<meta name="robots" content={blocked ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<Organization
			name={SITE_TITLE}
			url={`${SITE_ORIGIN}/`}
			logo={`${SITE_ORIGIN}/logo-512.png`}
			description="Morningwit publishes free logic puzzles and step-by-step hints for daily word and number puzzles."
			email={CONTACT_EMAIL}
		/>
		<WebSite name={SITE_TITLE} url={`${SITE_ORIGIN}/`} description={SITE_DESCRIPTION} />
		<script is:inline>
			// Theme first, so the page never flashes the wrong palette.
			try {
				var t = localStorage.getItem('mw:v1:theme');
				if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
			} catch (e) {}
		</script>
		<slot name="head" />
	</head>
	<body>
		<Icons />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		{ADS_ENABLED && (
			<div class="consent-bar" id="consent-bar" role="dialog" aria-label="Ad choices" hidden>
				<p>
					Ads from Adsterra keep Morningwit free. They can set cookies. Choose whether to load them.
					<a href="/privacy/">Privacy</a>
				</p>
				<div class="consent-actions">
					<button type="button" class="btn" id="consent-accept">Allow ads</button>
					<button type="button" class="btn" id="consent-decline">No ads</button>
				</div>
			</div>
		)}
		{ADS_ENABLED && (
			<script is:inline>
				// Ad consent. A browser time zone in Europe stands in for the EEA, UK and Switzerland: there, nothing loads until
				// the visitor allows it. Elsewhere ads load by default. Global Privacy Control or a stored "no" keeps them off.
				(function () {
					var KEY = 'mw-consent';
					var root = document.documentElement;
					var tz = '';
					try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
					var europe = /^(Europe\/|Atlantic\/(Canary|Madeira|Azores|Faroe|Reykjavik)|Arctic\/Longyearbyen)/.test(tz);
					var stored = '';
					try { stored = localStorage.getItem(KEY) || ''; } catch (e) {}
					var state = stored || (navigator.globalPrivacyControl ? 'denied' : europe ? 'ask' : 'granted');
					var loaded = false;

					function loadAds() {
						document.querySelectorAll('script[type="text/plain"][data-ads]').forEach(function (old) {
							var s = document.createElement('script');
							for (var i = 0; i < old.attributes.length; i++) {
								var a = old.attributes[i];
								if (a.name === 'type' || a.name === 'data-ads') continue;
								s.setAttribute(a.name, a.value);
							}
							if (old.src) s.async = false; else s.text = old.text;
							old.parentNode.replaceChild(s, old);
						});
					}
					function grant() {
						if (loaded) return;
						loaded = true;
						root.classList.remove('ads-off');
						var go = function () { if (window.requestIdleCallback) requestIdleCallback(loadAds, { timeout: 3000 }); else setTimeout(loadAds, 500); };
						if (document.readyState === 'complete') go(); else window.addEventListener('load', go);
					}
					function choose(value) {
						try { localStorage.setItem(KEY, value); } catch (e) {}
						var bar = document.getElementById('consent-bar');
						if (bar) bar.hidden = true;
						if (value === 'granted') grant();
						else if (loaded) location.reload();
						else root.classList.add('ads-off');
					}

					if (state === 'granted') grant(); else root.classList.add('ads-off');

					document.addEventListener('DOMContentLoaded', function () {
						var bar = document.getElementById('consent-bar');
						if (!bar) return;
						if (state === 'ask') bar.hidden = false;
						document.getElementById('consent-accept').addEventListener('click', function () { choose('granted'); });
						document.getElementById('consent-decline').addEventListener('click', function () { choose('denied'); });
						document.querySelectorAll('[data-consent-open]').forEach(function (b) {
							b.addEventListener('click', function () { bar.hidden = false; document.getElementById('consent-decline').focus(); });
						});
					});
				})();
			</script>
		)}
		<script is:inline>
			(function () {
				var btn = document.getElementById('theme-btn');
				if (!btn) return;
				btn.addEventListener('click', function () {
					var root = document.documentElement;
					var cur = root.getAttribute('data-theme');
					if (!cur) cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					var next = cur === 'dark' ? 'light' : 'dark';
					root.setAttribute('data-theme', next);
					try {
						localStorage.setItem('mw:v1:theme', next);
					} catch (e) {}
				});
			})();
		</script>
	</body>
</html>
