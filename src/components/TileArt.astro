---
interface Props { kind: 'binairo' | 'star' | 'daily' }
const { kind } = Astro.props;
---
{kind === 'binairo' && (
	<svg class="tile-art" viewBox="0 0 96 96" aria-hidden="true">
		<rect x="4" y="4" width="88" height="88" rx="18" fill="#e6f1ff" />
		<g fill="#fff">
			<rect x="10" y="10" width="24" height="24" rx="7" /><rect x="36" y="10" width="24" height="24" rx="7" /><rect x="62" y="10" width="24" height="24" rx="7" />
			<rect x="10" y="36" width="24" height="24" rx="7" /><rect x="36" y="36" width="24" height="24" rx="7" /><rect x="62" y="36" width="24" height="24" rx="7" />
			<rect x="10" y="62" width="24" height="24" rx="7" /><rect x="36" y="62" width="24" height="24" rx="7" /><rect x="62" y="62" width="24" height="24" rx="7" />
		</g>
		<g class="sun"><circle cx="22" cy="22" r="7" fill="#ff7a6b" /><circle cx="74" cy="48" r="7" fill="#ff7a6b" /><circle cx="48" cy="74" r="7" fill="#ff7a6b" /></g>
		<g fill="#4d8fd6"><path d="M55 20a8 8 0 1 0 9 9 6 6 0 0 1-9-9z" /><path d="M17 56a8 8 0 1 0 9 9 6 6 0 0 1-9-9z" /><path d="M69 68a8 8 0 1 0 9 9 6 6 0 0 1-9-9z" /></g>
	</svg>
)}
{kind === 'star' && (
	<svg class="tile-art" viewBox="0 0 96 96" aria-hidden="true">
		<rect x="4" y="4" width="88" height="88" rx="18" fill="#fff" />
		<g>
			<rect x="8" y="8" width="40" height="30" rx="8" fill="#ffd9c2" /><rect x="48" y="8" width="40" height="46" rx="8" fill="#d8ecff" />
			<rect x="8" y="38" width="24" height="50" rx="8" fill="#e2f4d4" /><rect x="32" y="38" width="16" height="50" fill="#fbe9a8" /><rect x="48" y="54" width="40" height="34" rx="8" fill="#eadcff" />
		</g>
		<g fill="#2a2540"><path d="M28 14l2.4 5 5.4.7-4 3.8.9 5.4L28 26.2l-4.7 2.7.9-5.4-4-3.8 5.4-.7z" /><path d="M68 58l2.4 5 5.4.7-4 3.8.9 5.4L68 70.2l-4.7 2.7.9-5.4-4-3.8 5.4-.7z" /><path d="M20 62l2.4 5 5.4.7-4 3.8.9 5.4L20 74.2l-4.7 2.7.9-5.4-4-3.8 5.4-.7z" /></g>
	</svg>
)}
{kind === 'daily' && (
	<svg class="tile-art" viewBox="0 0 96 96" aria-hidden="true">
		<rect x="4" y="4" width="88" height="88" rx="22" fill="#fffbf5" />
		<path d="M14 66a34 34 0 0 1 68 0z" fill="#ffb38a" />
		<path d="M26 66a22 22 0 0 1 44 0z" fill="#ff7a6b" />
		<g stroke="#2a2540" stroke-width="4" stroke-linecap="round"><path d="M48 16v9M22 26l6 6M74 26l-6 6M11 50h8M77 50h8" /></g>
		<rect x="14" y="70" width="68" height="12" rx="6" fill="#2a2540" />
	</svg>
)}
