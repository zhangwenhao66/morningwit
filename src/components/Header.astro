---
const path = Astro.url.pathname;
const items = [
	{ href: '/', label: 'Today', icon: 'i-home', match: (p: string) => p === '/' },
	{ href: '/play/', label: 'Games', icon: 'i-play', match: (p: string) => p.startsWith('/play') },
	{ href: '/daily/', label: 'Daily', icon: 'i-daily', match: (p: string) => p.startsWith('/daily') },
	{ href: '/about/', label: 'About', icon: 'i-info', match: (p: string) => p.startsWith('/about') || p.startsWith('/fair-hints') },
];
---
<header class="appbar">
	<div class="wrap appbar-in">
		<a class="brand" href="/" aria-label="Morningwit home">
			<svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
				<defs>
					<linearGradient id="bm" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0" stop-color="#ffb38a" />
						<stop offset=".55" stop-color="#ff7a6b" />
						<stop offset="1" stop-color="#8ec5ff" />
					</linearGradient>
				</defs>
				<rect x="2" y="2" width="36" height="36" rx="11" fill="url(#bm)" />
				<path d="M8 27a12 12 0 0 1 24 0z" fill="#fffbf5" />
				<path d="M20 9v4M10.5 13l2.6 2.6M29.5 13l-2.6 2.6" stroke="#fffbf5" stroke-width="2.4" stroke-linecap="round" />
			</svg>
			<span>Morningwit</span>
		</a>
		<nav class="topnav" aria-label="Main">
			{items.map((i) => <a href={i.href} aria-current={i.match(path) ? 'page' : undefined}>{i.label}</a>)}
		</nav>
		<button class="theme-btn" id="theme-btn" type="button" aria-label="Switch light or dark mode">
			<svg aria-hidden="true"><use href="#i-moon"></use></svg>
		</button>
	</div>
</header>
<nav class="tabbar" aria-label="Main">
	{items.map((i) => (
		<a href={i.href} aria-current={i.match(path) ? 'page' : undefined}>
			<span class="tab-ico"><svg aria-hidden="true"><use href={`#${i.icon}`}></use></svg></span>
			{i.label}
		</a>
	))}
</nav>
